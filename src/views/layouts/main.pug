doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || "FitStore"
    link(rel="stylesheet", href="/css/style.css")
  body
    header
      nav
        .nav-container
          a.logo(href="/vitrine") FitStore
          .search-box
            if mostrarBusca
              form(action="/vitrine", method="GET")
                input(
                  type="text",
                  name="busca",
                  placeholder="Nome ou referencia...",
                  value=busca
                )
                button(type="submit") Buscar
          
          .auth-status(style="display: flex; align-items: center;")
            if usuarioLogado
              span(style="color: white; margin-right: 20px; font-size: 0.95rem;") Ola, #[strong(style="color: var(--accent);")= usuarioLogado] (#{cargoUsuario})
              if cargoUsuario === 'gerente'
                a(href="/equipe" style="color: white; margin-right: 20px; text-decoration: none; font-weight: 600; font-size: 0.9rem; border-bottom: 2px solid var(--accent);") Gestao de Equipe
              a(href="/login" style="color: #a4b0be; text-decoration: none; font-size: 0.9rem;") Sair
            else
              a(href="/login" style="color: white; text-decoration: none; font-weight: bold; font-size: 0.9rem;") Entrar / Criar Conta

    main.container
      block content

    footer
      .footer-content
        p &copy; 2026 FitStore - Equipamentos e Roupas Fitness