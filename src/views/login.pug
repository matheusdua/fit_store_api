extends layouts/main.pug

block content
  .detalhe-container(style="max-width: 450px; margin: 4rem auto;")
    .detalhe-card
      h2(style="text-align: center; margin-bottom: 2rem;") Acessar Conta
      
      if erro
        .badge-esgotado(style="width: 100%; padding: 0.8rem; margin-bottom: 1.5rem; border-radius: 6px; text-align: center; box-sizing: border-box;") #{erro}

      form(action="/login" method="POST" style="display: flex; flex-direction: column; gap: 1.5rem;")
        .form-group(style="display: flex; flex-direction: column; gap: 0.5rem;")
          label(style="font-weight: 600; color: var(--primary);") Usuario ou E-mail
          input(
            type="text" 
            name="loginInput" 
            placeholder="Digite seu username ou email..." 
            required 
            style="padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;"
          )
        
        .form-group(style="display: flex; flex-direction: column; gap: 0.5rem;")
          label(style="font-weight: 600; color: var(--primary);") Senha
          input(
            type="password" 
            name="senha" 
            placeholder="Digite sua senha..." 
            required 
            style="padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;"
          )

        button.btn-comprar(type="submit" style="margin-top: 1rem; font-size: 1rem;") Entrar

      p(style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: #747d8c;") Nao tem uma conta? #[a(href="/register" style="color: var(--accent); font-weight: bold; text-decoration: none;") Cadastre-se gratis]