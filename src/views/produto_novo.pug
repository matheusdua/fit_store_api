extends layouts/main.pug

block content
  .detalhe-container(style="max-width: 600px; margin: 3rem auto;")
    .detalhe-card
      h2(style="text-align: center; margin-bottom: 2rem; color: var(--primary);") 📦 Cadastrar Novo Produto
      
      if erro
        .badge-esgotado(style="width: 100%; padding: 0.8rem; margin-bottom: 1.5rem; border-radius: 6px; text-align: center; box-sizing: border-box; background-color: var(--accent); color: white;") #{erro}

      form(action="/produtos/novo" method="POST" style="display: flex; flex-direction: column; gap: 1.2rem;")
        .form-group(style="display: flex; flex-direction: column; gap: 0.4rem;")
          label(style="font-weight: 600; color: var(--text);") Nome do Produto
          input(type="text" name="nome" placeholder="Ex: Camiseta Dry Fit Elite" searchable="false" required style="padding: 0.7rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;")
        
        .form-group(style="display: flex; flex-direction: column; gap: 0.4rem;")
          label(style="font-weight: 600; color: var(--text);") Referência Única (Código)
          input(type="text" name="referencia" placeholder="Ex: CAM-002-PT" required style="padding: 0.7rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;")
        
        div(style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;")
          .form-group(style="display: flex; flex-direction: column; gap: 0.4rem;")
            label(style="font-weight: 600; color: var(--text);") Categoria
            input(type="text" name="categoria" placeholder="Ex: Roupas" required style="padding: 0.7rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;")
          
          .form-group(style="display: flex; flex-direction: column; gap: 0.4rem;")
            label(style="font-weight: 600; color: var(--text);") Tamanho
            input(type="text" name="tamanho" placeholder="Ex: G" required style="padding: 0.7rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;")
        
        div(style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;")
          .form-group(style="display: flex; flex-direction: column; gap: 0.4rem;")
            label(style="font-weight: 600; color: var(--text);") Preço de Venda (R$)
            input(type="number" name="preco" step="0.01" placeholder="0.00" required style="padding: 0.7rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;")
          
          .form-group(style="display: flex; flex-direction: column; gap: 0.4rem;")
            label(style="font-weight: 600; color: var(--text);") Estoque Inicial (Unidades)
            input(type="number" name="estoque" placeholder="0" required style="padding: 0.7rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;")

        button.btn-comprar(type="submit" style="margin-top: 1.5rem; background-color: var(--success); font-size: 1.1rem; padding: 0.9rem;") Salvar e Publicar Produto
        
      a.btn-voltar(href="/vitrine" style="text-align: center; display: block; margin-top: 1.5rem;") &larr; Cancelar e Voltar